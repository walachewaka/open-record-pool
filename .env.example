# Optional credentials for the music download engine (MOO-78). All optional;
# nothing is needed for public content. See docs/DOWNLOADS.md.

# Spotify (spotDL): a free developer app avoids shared-key rate limiting. No
# Spotify account is needed to download -- spotDL fetches audio from YouTube
# Music. Set BOTH or neither.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SoundCloud (scdl): OAuth token from your browser session; unlocks
# higher-quality streams. Public tracks need nothing.
SOUNDCLOUD_AUTH_TOKEN=

# YouTube (yt-dlp): path to a mounted Netscape cookies.txt for age-restricted
# content, e.g. /config/yt-cookies.txt via a compose bind. Public videos need
# nothing.
YTDLP_COOKIES_FILE=


# ---------------------------------------------------------------------------
# Single sign-on (MOO-88). Everything below is optional: leave OIDC_PROVIDERS
# empty and the pool keeps working exactly as it does today (local accounts
# only). Full walkthrough: docs/SSO.md.
#
# Register this redirect URI with EVERY provider you enable:
#   <PUBLIC_BACKEND_URL>/auth/oidc/<provider-id>/callback
# ---------------------------------------------------------------------------

# The URLs browsers reach the pool on. The redirect URI is built from
# PUBLIC_BACKEND_URL (never from the request's Host header), and every SSO
# redirect lands on PUBLIC_FRONTEND_URL. Both must be https in production.
PUBLIC_BACKEND_URL=http://localhost:5000
PUBLIC_FRONTEND_URL=http://localhost:8088

# Turn the username/password form off for an IDP-only pool. The backend refuses
# to boot if this is false and no provider is configured (nobody could sign in).
LOCAL_LOGIN_ENABLED=true

# Let a verified IDP email claim an EXISTING local account with the same
# address. Off by default, deliberately: email-match linking is the classic SSO
# account-takeover primitive. The safe path is Account settings -> Link.
OIDC_EMAIL_AUTOLINK=false

# The providers to enable, in the order the buttons appear on the login gate.
# Each id below has its own OIDC_<ID>_* block. Adding e.g. Keycloak later means
# adding an id here plus its block -- no code change.
OIDC_PROVIDERS=

# Per-provider registration policy (OIDC_<ID>_PROVISIONING):
#   closed  (default) no account is ever created; the user must already have
#           this identity linked (admin creates the account, user links it).
#   invite  a first login creates a PENDING account an admin activates under
#           /admin/users?status=pending.
#   domain  a first login creates an active account, but only for the verified
#           domains in OIDC_<ID>_ALLOWED_DOMAINS.
#   open    anyone this IDP authenticates gets an account.

# --- Microsoft Entra ID / Microsoft 365 ---
# Entra portal -> App registrations -> New registration (Web, add the redirect
# URI above). Single-tenant: put your tenant id in the issuer. Multi-tenant: use
# the {tenantid} placeholder issuer AND the `common` discovery URL below.
OIDC_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC_ENTRA_ISSUER=https://login.microsoftonline.com/{tenantid}/v2.0
#OIDC_ENTRA_DISCOVERY_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration
OIDC_ENTRA_CLIENT_ID=
OIDC_ENTRA_CLIENT_SECRET=
OIDC_ENTRA_DISPLAY_NAME=Microsoft
OIDC_ENTRA_PROVISIONING=closed
OIDC_ENTRA_ALLOWED_DOMAINS=

# --- Google (consumer accounts) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application), add the redirect URI above.
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_DISPLAY_NAME=Google
OIDC_GOOGLE_PROVISIONING=closed

# --- Google Workspace (domain-locked) ---
# Same Google OIDC client (or its own); ALLOWED_DOMAINS turns on hosted-domain
# enforcement: the `hd` claim inside the verified ID token must match, so a
# personal gmail.com account cannot get in through this button.
OIDC_WORKSPACE_ISSUER=https://accounts.google.com
OIDC_WORKSPACE_CLIENT_ID=
OIDC_WORKSPACE_CLIENT_SECRET=
OIDC_WORKSPACE_DISPLAY_NAME=Google Workspace
OIDC_WORKSPACE_PROVISIONING=domain
OIDC_WORKSPACE_ALLOWED_DOMAINS=yourfirm.com

# --- Okta ---
# Okta admin console -> Applications -> Create App Integration -> OIDC Web App,
# add the redirect URI above. Use the org issuer, or a custom auth server's.
OIDC_OKTA_ISSUER=https://<your-org>.okta.com
OIDC_OKTA_CLIENT_ID=
OIDC_OKTA_CLIENT_SECRET=
OIDC_OKTA_DISPLAY_NAME=Okta
OIDC_OKTA_PROVISIONING=closed
OIDC_OKTA_ALLOWED_DOMAINS=

# Optional claim -> role mapping (any provider). Both must be set; `owner` is
# never mappable. With mapping off, locally assigned roles stay authoritative.
#OIDC_OKTA_GROUPS_CLAIM=groups
#OIDC_OKTA_GROUP_ROLE_MAP={"orp-admins": "admin", "orp-curators": "curator"}
